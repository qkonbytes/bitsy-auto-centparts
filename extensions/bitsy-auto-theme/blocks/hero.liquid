{%- liquid
  assign s = block.settings
  assign bid = 'bitsy-' | append: block.id
  assign cls = 'bitsy bitsy-hero-wrap'
  if s.full_width
    assign cls = cls | append: ' bitsy--full'
  endif
  unless s.show_mobile
    assign cls = cls | append: ' bitsy--hide-mobile'
  endunless
  unless s.show_desktop
    assign cls = cls | append: ' bitsy--hide-desktop'
  endunless
  if s.css_class != blank
    assign cls = cls | append: ' ' | append: s.css_class
  endif
  assign sel_id = '#' | append: bid
-%}
<script src="{{ 'bitsy.js' | asset_url }}" defer></script>
{%- liquid
  assign heights = 'small:420,medium:560,large:720' | split: ','
  assign h = s.height_custom | append: 'px'
  for p in heights
    assign kv = p | split: ':'
    if s.height == kv[0]
      assign h = kv[1] | append: 'px'
    endif
  endfor
  if s.height == 'full'
    assign h = '100vh'
  endif
  assign hm = s.height_m_custom | append: 'px'
  for p in heights
    assign kv = p | split: ':'
    if s.height_m == kv[0]
      assign hm = kv[1] | append: 'px'
    endif
  endfor
  if s.height_m == 'full'
    assign hm = '100svh'
  endif
  if s.height_m == 'same'
    assign hm = h
  endif
  assign o = s.overlay_opacity | divided_by: 100.0
  assign po = s.panel_opacity | divided_by: 100.0
  assign panel_bg = s.panel_bg | color_modify: 'alpha', po
  case s.v_align
    when 'top'
      assign va = 'flex-start'
    when 'bottom'
      assign va = 'flex-end'
    else
      assign va = 'center'
  endcase
  case s.h_align
    when 'center'
      assign ha = 'center'
    when 'right'
      assign ha = 'flex-end'
    else
      assign ha = 'flex-start'
  endcase
-%}
{%- capture extra -%}
--b-hero-h:{{ h }};--b-hero-h-m:{{ hm }};--b-valign:{{ va }};--b-halign:{{ ha }};--b-content-w:{{ s.content_width }}px;
--b-overlay-c:{{ s.overlay_color }};--b-overlay-o:{{ o }};--b-panel-bg:{{ panel_bg }};--b-panel-text:{{ s.panel_text }};
--b-panel-pad:{{ s.panel_pad }}px;--b-panel-r:{{ s.panel_radius }}px;{% if s.panel_shadow %}--b-panel-shadow:0 18px 40px rgba(0,0,0,.25);{% endif %}
{%- endcapture -%}
{%- render 'bitsy-config' -%}
{%- render 'bitsy-style', s: s, selector: sel_id, extra: extra -%}
<div id="{{ bid }}" class="{{ cls }}" {{ block.shopify_attributes }} style="padding:0">
  <section class="bitsy-hero" style="padding:var(--b-pt,0) var(--b-px,0) var(--b-pb,0)">
    {%- if s.image != blank -%}
      <div class="bitsy-hero__media bitsy-hero__media--desktop{% if s.image_mobile != blank %} bitsy-hero__media--has-mobile{% endif %}">
        {%- assign focal = 'object-position:' | append: s.image.presentation.focal_point -%}
        {{ s.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '750,1100,1500,1920,2400', alt: s.image.alt, style: focal }}
      </div>
    {%- endif -%}
    {%- if s.image_mobile != blank -%}
      <div class="bitsy-hero__media bitsy-hero__media--mobile">
        {%- assign focal_m = 'object-position:' | append: s.image_mobile.presentation.focal_point -%}
        {{ s.image_mobile | image_url: width: 1200 | image_tag: loading: 'eager', sizes: '100vw', widths: '450,750,1000,1200', alt: s.image_mobile.alt, style: focal_m }}
      </div>
    {%- endif -%}
    <div class="bitsy-hero__overlay" aria-hidden="true"></div>
    <div class="bitsy__inner">
      <div class="bitsy-hero__content">
        {%- if s.heading != blank -%}<h2 class="bitsy__heading">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.subheading != blank -%}<div class="bitsy__sub">{{ s.subheading }}</div>{%- endif -%}
        <div class="bitsy-hero__panel bitsy-hero__panel--{{ s.panel_style }}">
          {%- render 'bitsy-ymm', s: s -%}
        </div>
        {%- if s.link_text != blank and s.link_url != blank -%}<a class="bitsy-link" href="{{ s.link_url }}">{{ s.link_text }}</a>{%- endif -%}
      </div>
    </div>
  </section>
</div>
{% schema %}
{"name":"Vehicle search hero","target":"content","stylesheet":"bitsy.css","settings":[{"type":"header","content":"Image and size"},
{"type":"image_picker","id":"image","label":"Desktop image","info":"Set the focal point in the image picker."},
{"type":"image_picker","id":"image_mobile","label":"Mobile image","info":"Optional. Uses the desktop image when empty."},
{"type":"color","id":"overlay_color","label":"Overlay colour","default":"#000000"},
{"type":"range","id":"overlay_opacity","label":"Overlay opacity","min":0,"max":90,"step":5,"default":45,"unit":"%"},
{"type":"select","id":"height","label":"Height (desktop)","default":"medium","options":[{"value":"small","label":"Small"},{"value":"medium","label":"Medium"},{"value":"large","label":"Large"},{"value":"full","label":"Full screen"},{"value":"custom","label":"Custom"}]},
{"type":"range","id":"height_custom","label":"Custom height (desktop)","min":300,"max":1000,"step":10,"default":640,"unit":"px"},
{"type":"select","id":"height_m","label":"Height (mobile)","default":"small","options":[{"value":"same","label":"Same as desktop"},{"value":"small","label":"Small"},{"value":"medium","label":"Medium"},{"value":"large","label":"Large"},{"value":"full","label":"Full screen"},{"value":"custom","label":"Custom"}]},
{"type":"range","id":"height_m_custom","label":"Custom height (mobile)","min":240,"max":900,"step":10,"default":480,"unit":"px"},
{"type":"select","id":"h_align","label":"Content position (horizontal)","default":"left","options":[{"value":"left","label":"Left"},{"value":"center","label":"Centre"},{"value":"right","label":"Right"}]},
{"type":"select","id":"v_align","label":"Content position (vertical)","default":"middle","options":[{"value":"top","label":"Top"},{"value":"middle","label":"Middle"},{"value":"bottom","label":"Bottom"}]},
{"type":"range","id":"content_width","label":"Content width","min":400,"max":1200,"step":20,"default":760,"unit":"px"},
{"type":"header","content":"Content and panel"},
{"type":"text","id":"heading","label":"Heading","default":"The right part, first time"},
{"type":"richtext","id":"subheading","label":"Subheading","default":"<p>Choose your vehicle and we'll show only the parts that fit.</p>"},
{"type":"text","id":"link_text","label":"Secondary link text"},
{"type":"url","id":"link_url","label":"Secondary link"},
{"type":"select","id":"panel_style","label":"Panel style","default":"card","options":[{"value":"card","label":"Card"},{"value":"glass","label":"Glass (blurred)"},{"value":"none","label":"None"}]},
{"type":"color","id":"panel_bg","label":"Panel background","default":"#FFFFFF"},
{"type":"range","id":"panel_opacity","label":"Panel opacity","min":0,"max":100,"step":5,"default":100,"unit":"%"},
{"type":"color","id":"panel_text","label":"Panel text","default":"#1A1A1A"},
{"type":"range","id":"panel_pad","label":"Panel padding","min":8,"max":48,"step":2,"default":18,"unit":"px"},
{"type":"range","id":"panel_radius","label":"Panel corner radius","min":0,"max":32,"step":1,"default":12,"unit":"px"},
{"type":"checkbox","id":"panel_shadow","label":"Panel shadow","default":false},
{"type":"header","content":"Layout"},
{"type":"checkbox","id":"full_width","label":"Full width","default":false},
{"type":"range","id":"max_width","label":"Content max width","min":600,"max":1600,"step":20,"default":1200,"unit":"px"},
{"type":"range","id":"pad_top","label":"Padding top","min":0,"max":160,"step":4,"default":56,"unit":"px"},
{"type":"range","id":"pad_bottom","label":"Padding bottom","min":0,"max":160,"step":4,"default":56,"unit":"px"},
{"type":"range","id":"pad_top_m","label":"Padding top (mobile)","min":0,"max":120,"step":4,"default":40,"unit":"px"},
{"type":"range","id":"pad_bottom_m","label":"Padding bottom (mobile)","min":0,"max":120,"step":4,"default":40,"unit":"px"},
{"type":"range","id":"pad_x","label":"Padding left and right","min":0,"max":80,"step":2,"default":24,"unit":"px"},
{"type":"range","id":"pad_x_m","label":"Padding left and right (mobile)","min":0,"max":40,"step":2,"default":16,"unit":"px"},
{"type":"range","id":"margin_top","label":"Margin top","min":0,"max":120,"step":4,"default":0,"unit":"px"},
{"type":"range","id":"margin_bottom","label":"Margin bottom","min":0,"max":120,"step":4,"default":0,"unit":"px"},
{"type":"select","id":"align","label":"Alignment","default":"left","options":[{"value":"left","label":"Left"},{"value":"center","label":"Centre"},{"value":"right","label":"Right"}]},
{"type":"range","id":"gap","label":"Space between elements","min":0,"max":40,"step":2,"default":16,"unit":"px"},
{"type":"range","id":"heading_size","label":"Heading size","min":12,"max":72,"step":1,"default":46,"unit":"px"},
{"type":"range","id":"heading_size_m","label":"Heading size (mobile)","min":12,"max":48,"step":1,"default":30,"unit":"px"},
{"type":"checkbox","id":"show_desktop","label":"Show on desktop","default":true},
{"type":"checkbox","id":"show_mobile","label":"Show on mobile","default":true},
{"type":"text","id":"css_class","label":"Extra CSS class"},
{"type":"header","content":"Colours"},
{"type":"color","id":"color_bg","label":"Background","default":"#39434F","info":"Leave blank to use Bitsy Auto design."},
{"type":"color_background","id":"bg_gradient","label":"Background gradient","info":"Overrides the background colour."},
{"type":"color","id":"color_heading","label":"Heading","default":"#FFFFFF"},
{"type":"color","id":"color_text","label":"Text","default":"#FFFFFF"},
{"type":"color","id":"color_label","label":"Labels"},
{"type":"color","id":"color_link","label":"Links","default":"#FFFFFF"},
{"type":"color","id":"btn_bg","label":"Button background"},
{"type":"color","id":"btn_text","label":"Button text"},
{"type":"color","id":"btn2_text","label":"Secondary button and garage text","default":"#1A1A1A"},
{"type":"color","id":"btn2_border","label":"Secondary button and garage border","default":"#BDBDBD"},
{"type":"color","id":"garage_icon","label":"Garage icon","default":"#1A1A1A"},
{"type":"header","content":"Vehicle form"},
{"type":"select","id":"sel_layout","label":"Dropdown layout","default":"grid","options":[{"value":"row","label":"One row"},{"value":"grid","label":"2 × 2 grid"},{"value":"stacked","label":"Stacked"}]},
{"type":"checkbox","id":"show_labels","label":"Show labels above dropdowns","default":true},
{"type":"text","id":"btn_label","label":"Button text","default":"Find parts"},
{"type":"checkbox","id":"btn_icon","label":"Show search icon on button","default":false},
{"type":"select","id":"btn_width","label":"Button width","default":"auto","options":[{"value":"auto","label":"Fit text"},{"value":"full","label":"Full width"}]},
{"type":"select","id":"btn_width_m","label":"Button width (mobile)","default":"full","options":[{"value":"auto","label":"Fit text"},{"value":"full","label":"Full width"}]},
{"type":"checkbox","id":"show_vin","label":"Show VIN search","default":true},
{"type":"checkbox","id":"show_garage","label":"Show My Garage button","default":true},
{"type":"checkbox","id":"garage_icon_only","label":"Garage icon only (no text)","default":false},
{"type":"checkbox","id":"show_badge","label":"Show garage vehicle count","default":true},
{"type":"checkbox","id":"prefill","label":"Show the shopper's selected garage vehicle","default":true}]}
{% endschema %}
