{%- liquid
  assign s = block.settings
  assign bid = 'bitsy-' | append: block.id
  assign cls = 'bitsy bitsy-coll'
  if s.full_width
    assign cls = cls | append: ' bitsy--full'
  endif
  unless s.show_mobile
    assign cls = cls | append: ' bitsy--hide-mobile'
  endunless
  unless s.show_desktop
    assign cls = cls | append: ' bitsy--hide-desktop'
  endunless
  if s.css_class != blank
    assign cls = cls | append: ' ' | append: s.css_class
  endif
  assign sel_id = '#' | append: bid
-%}
<script src="{{ 'bitsy.js' | asset_url }}" defer></script>
{%- capture box_vars -%}
--b-box-bg:{{ s.box_bg }};--b-box-border:{{ s.box_border }};{% if s.box_text != blank %}--b-box-text:{{ s.box_text }};{% endif %}--b-box-r:{{ s.box_radius }}px;--b-box-pad:{{ s.box_pad }}px;
{% if s.box_shadow %}--b-box-shadow:0 6px 20px rgba(0,0,0,.08);{% endif %}
{%- endcapture -%}
{%- render 'bitsy-config' -%}
{%- render 'bitsy-style', s: s, selector: sel_id, extra: box_vars -%}
<div id="{{ bid }}" class="{{ cls }}" {{ block.shopify_attributes }}{% if s.sticky %} style="position:sticky;top:0;z-index:30"{% endif %}>
  <div class="bitsy__inner bitsy-results{% if s.filters_layout == 'drawer' %} bitsy-results--drawer{% endif %}{% if s.filters_position == 'right' %} bitsy-results--filters-right{% endif %}"
    data-bitsy-results data-mode="collection" data-collection-id="{{ collection.id }}" data-auto="{{ s.auto_filter }}"
    data-theme-grid="{{ s.theme_grid | escape }}" data-t-fits="{{ s.fits_text | escape }}" data-cols="{{ s.cols }}" data-cols-m="{{ s.cols_m }}"{% if s.per_page != 'app' %} data-per-page="{{ s.per_page }}"{% endif %}
    data-allow-cols="{{ s.allow_cols }}" data-allow-per-page="{{ s.allow_per_page }}" data-pagination="{{ s.pagination }}"
    data-show-sort="{{ s.show_sort }}" data-default-sort="{{ s.default_sort }}" data-filters-layout="{{ s.filters_layout }}"
    data-filter-counts="{{ s.filter_counts }}" data-t-count="{{ s.count_text | escape }}" data-t-clear="{{ s.clear_text | escape }}"
    data-t-filters="{{ s.filters_text | escape }}" data-t-more="{{ s.more_text | escape }}">
    <div class="bitsy-box bitsy-box--{{ s.box_style }}" style="display:flex;flex-direction:column;gap:var(--b-gap,10px)">
      <div class="bitsy-coll__state" data-coll-state hidden>
        <span class="bitsy-coll__fits"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7"/></svg><span data-coll-vehicle></span></span>
        <span class="bitsy-coll__count" data-results-count></span>
        <span class="bitsy-spacer"></span>
        <button type="button" class="bitsy-btn bitsy-btn--secondary" data-coll-change>{{ s.change_text }}</button>
        <button type="button" class="bitsy-link" data-coll-clear>{{ s.clear_vehicle_text }}</button>
      </div>
      <div data-coll-picker>
        {%- if s.heading != blank -%}<h2 class="bitsy__heading">{{ s.heading }}</h2>{%- endif -%}
        {%- render 'bitsy-ymm', s: s -%}
      </div>
    </div>
    <div data-results-out></div>
    <template data-empty>{{ s.no_results }}</template>
  </div>
</div>
{% schema %}
{"name":"Collection vehicle bar","target":"content","stylesheet":"bitsy.css","enabled_on":{"templates":["collection"]},"settings":[{"type":"header","content":"Content and box"},
{"type":"text","id":"heading","label":"Heading","default":"Shop this collection by vehicle"},
{"type":"text","id":"fits_text","label":"Fits message","default":"Showing parts that fit {vehicle}","info":"{vehicle} is replaced with the shopper's vehicle."},
{"type":"text","id":"count_text","label":"Count text","default":"{count} products fit","info":"{count} is replaced with the number of fitting products."},
{"type":"text","id":"change_text","label":"Change vehicle text","default":"Change vehicle"},
{"type":"text","id":"clear_vehicle_text","label":"Clear vehicle text","default":"Clear vehicle, show all"},
{"type":"richtext","id":"no_results","label":"Message when nothing in this collection fits","default":"<p>Nothing in this collection fits your vehicle. Try another collection or clear the vehicle.</p>"},
{"type":"checkbox","id":"auto_filter","label":"Filter automatically when a vehicle is selected in My Garage","default":true},
{"type":"checkbox","id":"sticky","label":"Stick to the top when scrolling","default":false},
{"type":"text","id":"theme_grid","label":"Theme product grid to hide while filtering","default":"#ProductGridContainer, #product-grid, .product-grid-container, .collection-product-grid, .collection__products, .pagination-wrapper, .facets-container","info":"CSS selectors of the theme's own collection grid, separated by commas."},
{"type":"select","id":"box_style","label":"Box style","default":"card","options":[{"value":"none","label":"None"},{"value":"card","label":"Card"},{"value":"outlined","label":"Outlined"}]},
{"type":"color","id":"box_bg","label":"Box background","default":"#F6F7F9"},
{"type":"color","id":"box_text","label":"Box text"},
{"type":"color","id":"box_border","label":"Box border","default":"#DADDE3"},
{"type":"range","id":"box_radius","label":"Box corner radius","min":0,"max":32,"step":1,"default":10,"unit":"px"},
{"type":"range","id":"box_pad","label":"Box padding","min":0,"max":48,"step":2,"default":16,"unit":"px"},
{"type":"checkbox","id":"box_shadow","label":"Box shadow","default":false},
{"type":"header","content":"Product grid"},
{"type":"range","id":"cols","label":"Columns (desktop)","min":2,"max":5,"step":1,"default":4},
{"type":"range","id":"cols_m","label":"Columns (mobile)","min":1,"max":2,"step":1,"default":2},
{"type":"select","id":"per_page","label":"Products per page","default":"app","options":[{"value":"app","label":"Use the app setting"},{"value":"12","label":"12"},{"value":"24","label":"24"},{"value":"36","label":"36"},{"value":"48","label":"48"}]},
{"type":"checkbox","id":"allow_cols","label":"Let shoppers change columns","default":true},
{"type":"checkbox","id":"allow_per_page","label":"Let shoppers change products per page","default":true},
{"type":"select","id":"pagination","label":"Pagination","default":"numbers","options":[{"value":"numbers","label":"Page numbers"},{"value":"more","label":"Load more button"},{"value":"infinite","label":"Infinite scroll"}]},
{"type":"text","id":"more_text","label":"Load more text","default":"Load more"},
{"type":"checkbox","id":"show_sort","label":"Show sorting","default":true},
{"type":"select","id":"default_sort","label":"Default sort","default":"stock","options":[{"value":"stock","label":"In stock first"},{"value":"best","label":"Best match"},{"value":"price-asc","label":"Price, low to high"},{"value":"price-desc","label":"Price, high to low"},{"value":"title-asc","label":"Name, A–Z"},{"value":"brand-asc","label":"Brand, A–Z"}]},
{"type":"select","id":"filters_layout","label":"Filter layout","default":"sidebar","options":[{"value":"sidebar","label":"Sidebar"},{"value":"drawer","label":"Drawer (button)"}]},
{"type":"select","id":"filters_position","label":"Sidebar position","default":"left","options":[{"value":"left","label":"Left"},{"value":"right","label":"Right"}]},
{"type":"checkbox","id":"filter_counts","label":"Show product counts in filters","default":true},
{"type":"text","id":"filters_text","label":"Filters heading","default":"Filters"},
{"type":"text","id":"clear_text","label":"Clear filters text","default":"Clear all"},
{"type":"paragraph","content":"Which filters show (Price, In stock, Product type, Brand) is set in the Bitsy Auto app › Settings. Card look: the Bitsy Auto product cards app embed."},
{"type":"header","content":"Layout"},
{"type":"checkbox","id":"full_width","label":"Full width","default":false},
{"type":"range","id":"max_width","label":"Content max width","min":600,"max":1600,"step":20,"default":1200,"unit":"px"},
{"type":"range","id":"pad_top","label":"Padding top","min":0,"max":160,"step":4,"default":8,"unit":"px"},
{"type":"range","id":"pad_bottom","label":"Padding bottom","min":0,"max":160,"step":4,"default":16,"unit":"px"},
{"type":"range","id":"pad_top_m","label":"Padding top (mobile)","min":0,"max":120,"step":4,"default":12,"unit":"px"},
{"type":"range","id":"pad_bottom_m","label":"Padding bottom (mobile)","min":0,"max":120,"step":4,"default":12,"unit":"px"},
{"type":"range","id":"pad_x","label":"Padding left and right","min":0,"max":80,"step":2,"default":24,"unit":"px"},
{"type":"range","id":"pad_x_m","label":"Padding left and right (mobile)","min":0,"max":40,"step":2,"default":16,"unit":"px"},
{"type":"range","id":"margin_top","label":"Margin top","min":0,"max":120,"step":4,"default":0,"unit":"px"},
{"type":"range","id":"margin_bottom","label":"Margin bottom","min":0,"max":120,"step":4,"default":0,"unit":"px"},
{"type":"select","id":"align","label":"Alignment","default":"left","options":[{"value":"left","label":"Left"},{"value":"center","label":"Centre"},{"value":"right","label":"Right"}]},
{"type":"range","id":"gap","label":"Space between elements","min":0,"max":40,"step":2,"default":10,"unit":"px"},
{"type":"range","id":"heading_size","label":"Heading size","min":12,"max":72,"step":1,"default":16,"unit":"px"},
{"type":"range","id":"heading_size_m","label":"Heading size (mobile)","min":12,"max":48,"step":1,"default":15,"unit":"px"},
{"type":"checkbox","id":"show_desktop","label":"Show on desktop","default":true},
{"type":"checkbox","id":"show_mobile","label":"Show on mobile","default":true},
{"type":"text","id":"css_class","label":"Extra CSS class"},
{"type":"header","content":"Colours"},
{"type":"color","id":"color_bg","label":"Background","info":"Leave blank to use Bitsy Auto design."},
{"type":"color_background","id":"bg_gradient","label":"Background gradient","info":"Overrides the background colour."},
{"type":"color","id":"color_heading","label":"Heading"},
{"type":"color","id":"color_text","label":"Text"},
{"type":"color","id":"color_label","label":"Labels"},
{"type":"color","id":"color_link","label":"Links"},
{"type":"color","id":"btn_bg","label":"Button background","default":"#1F2A44"},
{"type":"color","id":"btn_text","label":"Button text","default":"#FFFFFF"},
{"type":"color","id":"btn2_text","label":"Secondary button and garage text"},
{"type":"color","id":"btn2_border","label":"Secondary button and garage border"},
{"type":"color","id":"garage_icon","label":"Garage icon"},
{"type":"header","content":"Vehicle form"},
{"type":"select","id":"sel_layout","label":"Dropdown layout","default":"row","options":[{"value":"row","label":"One row"},{"value":"grid","label":"2 × 2 grid"},{"value":"stacked","label":"Stacked"}]},
{"type":"checkbox","id":"show_labels","label":"Show labels above dropdowns","default":false},
{"type":"text","id":"btn_label","label":"Button text","default":"Find parts"},
{"type":"checkbox","id":"btn_icon","label":"Show search icon on button","default":false},
{"type":"select","id":"btn_width","label":"Button width","default":"auto","options":[{"value":"auto","label":"Fit text"},{"value":"full","label":"Full width"}]},
{"type":"select","id":"btn_width_m","label":"Button width (mobile)","default":"full","options":[{"value":"auto","label":"Fit text"},{"value":"full","label":"Full width"}]},
{"type":"checkbox","id":"show_vin","label":"Show VIN search","default":true},
{"type":"checkbox","id":"show_garage","label":"Show My Garage button","default":true},
{"type":"checkbox","id":"garage_icon_only","label":"Garage icon only (no text)","default":true},
{"type":"checkbox","id":"show_badge","label":"Show garage vehicle count","default":true},
{"type":"checkbox","id":"prefill","label":"Show the shopper's selected garage vehicle","default":true}]}
{% endschema %}
