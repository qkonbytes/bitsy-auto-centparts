{%- liquid
  assign s = block.settings
  assign bid = 'bitsy-' | append: block.id
  assign cls = 'bitsy bitsy-embed'
  if s.full_width
    assign cls = cls | append: ' bitsy--full'
  endif
  unless s.show_mobile
    assign cls = cls | append: ' bitsy--hide-mobile'
  endunless
  unless s.show_desktop
    assign cls = cls | append: ' bitsy--hide-desktop'
  endunless
  if s.css_class != blank
    assign cls = cls | append: ' ' | append: s.css_class
  endif
  assign sel_id = '#' | append: bid
-%}
<script src="{{ 'bitsy.js' | asset_url }}" defer></script>
{%- liquid
  assign hide_key = 'hide_' | append: template.name | replace: '-', '_'
  assign o = s.overlay_opacity | divided_by: 100.0
  assign overlay = s.overlay_color | color_modify: 'alpha', o
  assign bar_cls = 'bitsy-bar'
  if s.sticky
    assign bar_cls = bar_cls | append: ' bitsy-bar--sticky'
  endif
  if s.mobile_style == 'collapse'
    assign bar_cls = bar_cls | append: ' bitsy-bar--collapse'
  endif
-%}
{%- capture extra -%}
--b-border-w:{{ s.border_width }}px;--b-border-c:{{ s.border_color }};--b-modal-w:{{ s.modal_width }}px;--b-modal-r:{{ s.modal_radius }}px;
--b-overlay:{{ overlay }};--b-modal-bg:{{ s.modal_bg }};--b-modal-text:{{ s.modal_text }};
{%- endcapture -%}
{%- render 'bitsy-config', s: s -%}
{%- unless s[hide_key] -%}
{%- render 'bitsy-style', s: s, selector: '#bitsy-bar', extra: extra -%}
<div id="bitsy-bar" class="{{ cls }}" data-bitsy-modal-host>
  <div class="{{ bar_cls }}" data-bitsy-bar data-position="{{ s.position }}"{% if s.stuck_shadow %} data-stuck-shadow{% endif %}>
    <div class="bitsy__inner">
      <div style="display:flex;flex-wrap:wrap;align-items:center;gap:var(--b-gap,10px)">
        {%- if s.heading != blank -%}<span class="bitsy-bar__title{% unless s.heading_mobile %} bitsy--hide-mobile{% endunless %}">{{ s.heading }}</span>{%- endif -%}
        <button type="button" class="bitsy-btn bitsy-bar__toggle" aria-expanded="false">{{ s.collapse_label }}</button>
        <div class="bitsy-bar__form" style="flex:1 1 640px;min-width:0">{%- render 'bitsy-ymm', s: s -%}</div>
      </div>
    </div>
  </div>
</div>
{%- endunless -%}
{% schema %}
{"name":"Vehicle nav bar","target":"body","stylesheet":"bitsy.css","settings":[{"type":"header","content":"Nav bar"},
{"type":"select","id":"position","label":"Position","default":"below","options":[{"value":"below","label":"Below the theme header"},{"value":"above","label":"Above the theme header"}]},
{"type":"checkbox","id":"sticky","label":"Stick to the top when scrolling","default":true},
{"type":"checkbox","id":"stuck_shadow","label":"Shadow while stuck","default":true},
{"type":"text","id":"heading","label":"Heading","default":"Find parts for your vehicle"},
{"type":"checkbox","id":"heading_mobile","label":"Show heading on mobile","default":false},
{"type":"select","id":"mobile_style","label":"On mobile","default":"collapse","options":[{"value":"full","label":"Show the full bar"},{"value":"collapse","label":"Collapse to a button"}]},
{"type":"text","id":"collapse_label","label":"Collapsed button text","default":"Select vehicle"},
{"type":"range","id":"border_width","label":"Bottom border width","min":0,"max":4,"step":1,"default":0,"unit":"px"},
{"type":"color","id":"border_color","label":"Bottom border colour","default":"#000000"},
{"type":"checkbox","id":"hide_index","label":"Hide on home page","default":false},
{"type":"checkbox","id":"hide_product","label":"Hide on product pages","default":false},
{"type":"checkbox","id":"hide_collection","label":"Hide on collection pages","default":false},
{"type":"checkbox","id":"hide_search","label":"Hide on search","default":false},
{"type":"checkbox","id":"hide_cart","label":"Hide on cart","default":false},
{"type":"checkbox","id":"hide_page","label":"Hide on other pages","default":false},
{"type":"checkbox","id":"hide_blog","label":"Hide on blog","default":false},
{"type":"checkbox","id":"hide_article","label":"Hide on articles","default":false},
{"type":"checkbox","id":"hide_list_collections","label":"Hide on collection list","default":false},
{"type":"header","content":"Layout"},
{"type":"checkbox","id":"full_width","label":"Full width","default":false},
{"type":"range","id":"max_width","label":"Content max width","min":600,"max":1600,"step":20,"default":1200,"unit":"px"},
{"type":"range","id":"pad_top","label":"Padding top","min":0,"max":160,"step":4,"default":8,"unit":"px"},
{"type":"range","id":"pad_bottom","label":"Padding bottom","min":0,"max":160,"step":4,"default":8,"unit":"px"},
{"type":"range","id":"pad_top_m","label":"Padding top (mobile)","min":0,"max":120,"step":4,"default":8,"unit":"px"},
{"type":"range","id":"pad_bottom_m","label":"Padding bottom (mobile)","min":0,"max":120,"step":4,"default":8,"unit":"px"},
{"type":"range","id":"pad_x","label":"Padding left and right","min":0,"max":80,"step":2,"default":24,"unit":"px"},
{"type":"range","id":"pad_x_m","label":"Padding left and right (mobile)","min":0,"max":40,"step":2,"default":16,"unit":"px"},
{"type":"range","id":"margin_top","label":"Margin top","min":0,"max":120,"step":4,"default":0,"unit":"px"},
{"type":"range","id":"margin_bottom","label":"Margin bottom","min":0,"max":120,"step":4,"default":0,"unit":"px"},
{"type":"select","id":"align","label":"Alignment","default":"left","options":[{"value":"left","label":"Left"},{"value":"center","label":"Centre"},{"value":"right","label":"Right"}]},
{"type":"range","id":"gap","label":"Space between elements","min":0,"max":40,"step":2,"default":10,"unit":"px"},
{"type":"range","id":"heading_size","label":"Heading size","min":12,"max":72,"step":1,"default":16,"unit":"px"},
{"type":"range","id":"heading_size_m","label":"Heading size (mobile)","min":12,"max":48,"step":1,"default":15,"unit":"px"},
{"type":"checkbox","id":"show_desktop","label":"Show on desktop","default":true},
{"type":"checkbox","id":"show_mobile","label":"Show on mobile","default":true},
{"type":"text","id":"css_class","label":"Extra CSS class"},
{"type":"header","content":"Colours"},
{"type":"color","id":"color_bg","label":"Background","default":"#1F2A44","info":"Leave blank to use Bitsy Auto design."},
{"type":"color_background","id":"bg_gradient","label":"Background gradient","info":"Overrides the background colour."},
{"type":"color","id":"color_heading","label":"Heading","default":"#FFFFFF"},
{"type":"color","id":"color_text","label":"Text","default":"#FFFFFF"},
{"type":"color","id":"color_label","label":"Labels","default":"#FFFFFF"},
{"type":"color","id":"color_link","label":"Links","default":"#FFFFFF"},
{"type":"color","id":"btn_bg","label":"Button background"},
{"type":"color","id":"btn_text","label":"Button text"},
{"type":"color","id":"btn2_text","label":"Secondary button and garage text","default":"#FFFFFF"},
{"type":"color","id":"btn2_border","label":"Secondary button and garage border","default":"#FFFFFF"},
{"type":"color","id":"garage_icon","label":"Garage icon","default":"#FFFFFF"},
{"type":"header","content":"Vehicle form"},
{"type":"select","id":"sel_layout","label":"Dropdown layout","default":"row","options":[{"value":"row","label":"One row"},{"value":"grid","label":"2 × 2 grid"},{"value":"stacked","label":"Stacked"}]},
{"type":"checkbox","id":"show_labels","label":"Show labels above dropdowns","default":false},
{"type":"text","id":"btn_label","label":"Button text","default":"Find parts"},
{"type":"checkbox","id":"btn_icon","label":"Show search icon on button","default":false},
{"type":"select","id":"btn_width","label":"Button width","default":"auto","options":[{"value":"auto","label":"Fit text"},{"value":"full","label":"Full width"}]},
{"type":"select","id":"btn_width_m","label":"Button width (mobile)","default":"full","options":[{"value":"auto","label":"Fit text"},{"value":"full","label":"Full width"}]},
{"type":"checkbox","id":"show_vin","label":"Show VIN search","default":true},
{"type":"checkbox","id":"show_garage","label":"Show My Garage button","default":true},
{"type":"checkbox","id":"garage_icon_only","label":"Garage icon only (no text)","default":true},
{"type":"checkbox","id":"show_badge","label":"Show garage vehicle count","default":true},
{"type":"checkbox","id":"prefill","label":"Show the shopper's selected garage vehicle","default":true},
{"type":"header","content":"My Garage popup"},
{"type":"text","id":"garage_title","label":"Title","default":"My Garage"},
{"type":"text","id":"garage_empty","label":"Empty garage message","default":"No vehicles saved yet. Add one to see only the parts that fit."},
{"type":"text","id":"garage_add","label":"Add vehicle text","default":"+ Add a vehicle"},
{"type":"text","id":"garage_save","label":"Save vehicle text","default":"Save to garage"},
{"type":"text","id":"garage_cancel","label":"Cancel text","default":"Cancel"},
{"type":"text","id":"garage_selected","label":"Selected label","default":"Selected"},
{"type":"text","id":"garage_shop","label":"Shop button text","default":"Shop parts for selected vehicle"},
{"type":"text","id":"garage_full","label":"Garage full message","default":"Garage full: remove a vehicle to add one"},
{"type":"checkbox","id":"garage_show_ktype","label":"Show the TecDoc KType line","default":true},
{"type":"checkbox","id":"garage_show_vin","label":"Show 'VIN saved' line","default":true},
{"type":"range","id":"modal_width","label":"Popup width","min":360,"max":720,"step":10,"default":520,"unit":"px"},
{"type":"range","id":"modal_radius","label":"Popup corner radius","min":0,"max":24,"step":1,"default":12,"unit":"px"},
{"type":"color","id":"modal_bg","label":"Popup background","default":"#FFFFFF"},
{"type":"color","id":"modal_text","label":"Popup text","default":"#1A1A1A"},
{"type":"color","id":"overlay_color","label":"Overlay colour","default":"#000000"},
{"type":"range","id":"overlay_opacity","label":"Overlay opacity","min":0,"max":90,"step":5,"default":50,"unit":"%"}]}
{% endschema %}
