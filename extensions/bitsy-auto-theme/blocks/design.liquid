{%- liquid
  assign s = block.settings
-%}
{%- render 'bitsy-style', s: s, selector: ':root', extra: '' -%}
<script type="application/json" data-bitsy-config>
{"texts": {
  "labels": {"make": {{ s.label_make | json }}, "model": {{ s.label_model | json }}, "year": {{ s.label_year | json }}, "engine": {{ s.label_engine | json }}},
  "placeholders": {"make": {{ s.ph_make | json }}, "model": {{ s.ph_model | json }}, "year": {{ s.ph_year | json }}, "engine": {{ s.ph_engine | json }}},
  "incomplete": {{ s.msg_incomplete | json }}, "vinLink": {{ s.vin_link | json }}, "vinBack": {{ s.vin_back | json }},
  "vinPlaceholder": {{ s.vin_placeholder | json }}, "vinPaused": {{ s.vin_paused | json }}, "garageLabel": {{ s.garage_label | json }},
  "autoAdvance": {{ s.auto_advance | json }}
}}
</script>
{% schema %}
{"name":"Bitsy Auto design","target":"head","settings":[{"type":"header","content":"Typography"},
{"type":"checkbox","id":"use_theme_fonts","label":"Use the theme's fonts","default":true},
{"type":"font_picker","id":"heading_font","label":"Heading font","default":"assistant_n7","info":"Used when 'Use the theme's fonts' is off."},
{"type":"font_picker","id":"body_font","label":"Body font","default":"assistant_n4"},
{"type":"range","id":"body_size","label":"Text size","min":11,"max":22,"step":1,"default":15,"unit":"px"},
{"type":"range","id":"label_size","label":"Label size","min":10,"max":18,"step":1,"default":12,"unit":"px"},
{"type":"range","id":"button_size","label":"Button text size","min":11,"max":22,"step":1,"default":15,"unit":"px"},
{"type":"range","id":"letter_spacing","label":"Heading letter spacing","min":-1,"max":5,"step":0.1,"default":0,"unit":"px"},
{"type":"range","id":"line_height","label":"Line height","min":1,"max":2,"step":0.05,"default":1.5},
{"type":"select","id":"heading_case","label":"Heading text case","default":"none","options":[{"value":"none","label":"As typed"},{"value":"uppercase","label":"UPPERCASE"},{"value":"capitalize","label":"Capitalised"}]},
{"type":"select","id":"label_case","label":"Label text case","default":"none","options":[{"value":"none","label":"As typed"},{"value":"uppercase","label":"UPPERCASE"},{"value":"capitalize","label":"Capitalised"}]},
{"type":"select","id":"button_case","label":"Button text case","default":"none","options":[{"value":"none","label":"As typed"},{"value":"uppercase","label":"UPPERCASE"},{"value":"capitalize","label":"Capitalised"}]},
{"type":"header","content":"Colours"},
{"type":"color","id":"color_heading","label":"Heading","default":"#1A1A1A"},
{"type":"color","id":"color_text","label":"Text","default":"#1A1A1A"},
{"type":"color","id":"color_label","label":"Labels","default":"#1A1A1A"},
{"type":"color","id":"color_link","label":"Links","default":"#1F2A44"},
{"type":"color","id":"sel_bg","label":"Dropdown background","default":"#FFFFFF"},
{"type":"color","id":"sel_text","label":"Dropdown text","default":"#1A1A1A"},
{"type":"color","id":"sel_border","label":"Dropdown border","default":"#BDBDBD"},
{"type":"color","id":"sel_dis_bg","label":"Dropdown background (not ready)","default":"#EEEEEE"},
{"type":"color","id":"sel_dis_text","label":"Dropdown text (not ready)","default":"#6B6B6B"},
{"type":"color","id":"focus","label":"Focus ring","default":"#005BD3"},
{"type":"color","id":"btn_bg","label":"Button background","default":"#F2B705"},
{"type":"color","id":"btn_text","label":"Button text","default":"#1A1A1A"},
{"type":"color","id":"btn_border","label":"Button border"},
{"type":"color","id":"btn_hover_bg","label":"Button background (hover)"},
{"type":"color","id":"btn_hover_text","label":"Button text (hover)"},
{"type":"color","id":"btn2_bg","label":"Secondary button background"},
{"type":"color","id":"btn2_text","label":"Secondary button text"},
{"type":"color","id":"btn2_border","label":"Secondary button border"},
{"type":"color","id":"btn2_hover_bg","label":"Secondary button background (hover)"},
{"type":"color","id":"btn2_hover_text","label":"Secondary button text (hover)"},
{"type":"color","id":"badge_bg","label":"Garage count background","default":"#F2B705"},
{"type":"color","id":"badge_text","label":"Garage count text","default":"#1A1A1A"},
{"type":"color","id":"success","label":"'Fits' and success messages","default":"#1E6B3A"},
{"type":"color","id":"error","label":"Error messages","default":"#B3261E"},
{"type":"header","content":"Dropdowns"},
{"type":"range","id":"sel_height","label":"Height","min":32,"max":64,"step":2,"default":44,"unit":"px"},
{"type":"range","id":"sel_radius","label":"Corner radius","min":0,"max":32,"step":1,"default":6,"unit":"px"},
{"type":"range","id":"sel_border_width","label":"Border width","min":0,"max":4,"step":1,"default":1,"unit":"px"},
{"type":"range","id":"sel_pad","label":"Inner padding","min":4,"max":24,"step":1,"default":12,"unit":"px"},
{"type":"checkbox","id":"auto_advance","label":"Move to the next dropdown automatically","default":true},
{"type":"text","id":"label_make","label":"Make label","default":"Make"},
{"type":"text","id":"label_model","label":"Model label","default":"Model"},
{"type":"text","id":"label_year","label":"Year label","default":"Year"},
{"type":"text","id":"label_engine","label":"Engine label","default":"Engine"},
{"type":"text","id":"ph_make","label":"Make placeholder","default":"Select make"},
{"type":"text","id":"ph_model","label":"Model placeholder","default":"Select model"},
{"type":"text","id":"ph_year","label":"Year placeholder","default":"Select year"},
{"type":"text","id":"ph_engine","label":"Engine placeholder","default":"Select engine"},
{"type":"text","id":"msg_incomplete","label":"Message when not all are chosen","default":"Choose Make, Model, Year and Engine."},
{"type":"header","content":"Buttons"},
{"type":"range","id":"btn_height","label":"Height","min":32,"max":64,"step":2,"default":44,"unit":"px"},
{"type":"range","id":"btn_radius","label":"Corner radius","min":0,"max":32,"step":1,"default":6,"unit":"px"},
{"type":"range","id":"btn_border_width","label":"Border width","min":0,"max":4,"step":1,"default":0,"unit":"px"},
{"type":"range","id":"btn_pad","label":"Side padding","min":8,"max":48,"step":2,"default":18,"unit":"px"},
{"type":"select","id":"btn_weight","label":"Font weight","default":"700","options":[{"value":"400","label":"Regular"},{"value":"500","label":"Medium"},{"value":"600","label":"Semibold"},{"value":"700","label":"Bold"},{"value":"800","label":"Extra bold"}]},
{"type":"header","content":"VIN search and My Garage"},
{"type":"text","id":"vin_link","label":"VIN link text","default":"Search by VIN"},
{"type":"text","id":"vin_back","label":"Back-to-dropdowns text","default":"Use Make and Model"},
{"type":"text","id":"vin_placeholder","label":"VIN placeholder","default":"Enter your 17-character VIN"},
{"type":"text","id":"vin_paused","label":"Message when the monthly VIN limit is reached","default":"VIN search is paused for now. Please choose your vehicle by Make and Model."},
{"type":"text","id":"garage_label","label":"My Garage button text","default":"My Garage"},
{"type":"range","id":"icon_size","label":"Garage icon size","min":16,"max":40,"step":1,"default":22,"unit":"px"},
{"type":"textarea","id":"custom_css","label":"Custom CSS for all Bitsy blocks","info":"Example: .bitsy-btn { letter-spacing: 1px; }"}]}
{% endschema %}
